direction: down

forward: {
  label: "Forward：先算出本次结果，同时留下节点和边"
  direction: right
  style.fill: "#F7FAFF"
  style.stroke: "#A8C5F5"
  style.border-radius: 8

  w: "w = 2\n需要梯度" {
    style.fill: "#DCEBFF"
    style.stroke: "#4D83D1"
  }
  x: "x = 3\n固定输入" {
    style.fill: "#EAF2FF"
    style.stroke: "#7AA2DE"
  }
  mul: "乘法\nm = w × x = 6" {
    shape: hexagon
    style.fill: "#FFF0D8"
    style.stroke: "#E59A2E"
  }
  b: "b = -1\n需要梯度" {
    style.fill: "#DCEBFF"
    style.stroke: "#4D83D1"
  }
  add: "加法\nz = m + b = 5" {
    shape: hexagon
    style.fill: "#FFF0D8"
    style.stroke: "#E59A2E"
  }
  target: "target = 4" {
    style.fill: "#EAF2FF"
    style.stroke: "#7AA2DE"
  }
  sub: "减法\ne = z - target = 1" {
    shape: hexagon
    style.fill: "#FFF0D8"
    style.stroke: "#E59A2E"
  }
  square: "平方\nloss = e² = 1" {
    shape: hexagon
    style.fill: "#FFE2E5"
    style.stroke: "#D95D6C"
  }

  w -> mul
  x -> mul
  mul -> add
  b -> add
  add -> sub
  target -> sub
  sub -> square
}

backward: {
  label: "Backward：从 loss 对自己的导数 1 出发，沿图反向传梯度"
  direction: left
  style.fill: "#FFF9FA"
  style.stroke: "#E7A6AE"
  style.border-radius: 8

  loss_seed: "dL/dL = 1" {
    style.fill: "#FFE2E5"
    style.stroke: "#D95D6C"
  }
  error_grad: "dL/de = 2e = 2" {
    style.fill: "#FFECEF"
    style.stroke: "#D95D6C"
  }
  z_grad: "dL/dz = 2" {
    style.fill: "#FFECEF"
    style.stroke: "#D95D6C"
  }
  parameter_grads: "dL/dw = 2 × x = 6\ndL/db = 2" {
    style.fill: "#DFF6EA"
    style.stroke: "#3C9A69"
  }

  loss_seed -> error_grad: "平方的局部导数 2e"
  error_grad -> z_grad: "减法的局部导数 1"
  z_grad -> parameter_grads: "乘法读取 forward 的 x = 3"
}

forward -> backward: "同一条链，反向读取 forward 留下的关系与必要数值" {
  style.stroke: "#7C879B"
  style.stroke-dash: 4
}
