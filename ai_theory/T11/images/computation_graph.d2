direction: down

forward: {
  label: "Forward：先算出本次结果，同时留下节点和边"
  direction: right
  style.fill: "#F7FAFF"
  style.stroke: "#A8C5F5"
  style.border-radius: 8

  w: "w = 2\n需要梯度" {
    style.fill: "#DCEBFF"
    style.stroke: "#4D83D1"
  }
  x: "x = 3\n固定输入" {
    style.fill: "#EAF2FF"
    style.stroke: "#7AA2DE"
  }
  mul: "乘法\nm = w × x = 6" {
    shape: hexagon
    style.fill: "#FFF0D8"
    style.stroke: "#E59A2E"
  }
  b: "b = -1\n需要梯度" {
    style.fill: "#DCEBFF"
    style.stroke: "#4D83D1"
  }
  add: "加法\nz = m + b = 5" {
    shape: hexagon
    style.fill: "#FFF0D8"
    style.stroke: "#E59A2E"
  }
  target: "target = 4" {
    style.fill: "#EAF2FF"
    style.stroke: "#7AA2DE"
  }
  sub: "减法\ne = z - target = 1" {
    shape: hexagon
    style.fill: "#FFF0D8"
    style.stroke: "#E59A2E"
  }
  square: "平方\nloss = e² = 1" {
    shape: hexagon
    style.fill: "#FFE2E5"
    style.stroke: "#D95D6C"
  }

  w -> mul
  x -> mul
  mul -> add
  b -> add
  add -> sub
  target -> sub
  sub -> square
}

backward: {
  label: "Backward：每个反向节点都对应上面一步 forward 运算"
  direction: down
  style.fill: "#FFF9FA"
  style.stroke: "#E7A6AE"
  style.border-radius: 8

  loss_seed: "loss 端的起点\ndL/dL = 1" {
    style.fill: "#FFE2E5"
    style.stroke: "#D95D6C"
  }
  pow: "PowBackward0\n对应 forward 平方\ndL/de = 2e = 2" {
    style.fill: "#FFECEF"
    style.stroke: "#D95D6C"
  }
  sub: "SubBackward0\n对应 forward 减法\ndL/dz = 2" {
    style.fill: "#FFECEF"
    style.stroke: "#D95D6C"
  }
  add: "AddBackward0\n对应 forward 加法\ndL/dm = 2，dL/db = 2" {
    style.fill: "#FFF4DF"
    style.stroke: "#D8922B"
  }
  mul: "MulBackward0\n对应 forward 乘法\n读取 x = 3，dL/dw = 6" {
    style.fill: "#DFF6EA"
    style.stroke: "#3C9A69"
  }

  loss_seed -> pow: "从最终结果开始"
  pow -> sub: "平方的局部导数 2e"
  sub -> add: "减法对 z 的局部导数 1"
  add -> mul: "加法把梯度传给 m 与 b"
}

forward -> backward: "同一条链，反向读取 forward 留下的关系与必要数值" {
  style.stroke: "#7C879B"
  style.stroke-dash: 4
}
