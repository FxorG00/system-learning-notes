direction: down

loss: "loss\n起点 dL/dL = 1" {
  style.fill: "#FFE2E5"
  style.stroke: "#D95D6C"
  style.border-radius: 8
}

pow: "PowBackward0\nloss = error²\n传给 error: 2" {
  style.fill: "#FFECEF"
  style.stroke: "#D95D6C"
  style.border-radius: 8
}

sub: "SubBackward0\nerror = z - 4\n传给 z: 2" {
  style.fill: "#FFECEF"
  style.stroke: "#D95D6C"
  style.border-radius: 8
}

add: "AddBackward0\nz = product + b\n把梯度 2 分给两侧" {
  style.fill: "#FFF4DF"
  style.stroke: "#D8922B"
  style.border-radius: 8
}

mul: "MulBackward0\nproduct = w × x\n读取 x = 3，得到 6" {
  style.fill: "#E6F7EF"
  style.stroke: "#3C9A69"
  style.border-radius: 8
}

b_grad: "b.grad = 2" {
  style.fill: "#DFF6EA"
  style.stroke: "#3C9A69"
  style.border-radius: 8
}

w_grad: "w.grad = 6" {
  style.fill: "#DFF6EA"
  style.stroke: "#3C9A69"
  style.border-radius: 8
}

loss -> pow
pow -> sub: "2"
sub -> add: "2"
add -> mul: "product 路径"
add -> b_grad: "b 路径"
mul -> w_grad: "w 路径"
